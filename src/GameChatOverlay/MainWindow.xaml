<Window x:Class="GameChatOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="{DynamicResource AppTitle}" Icon="Assets/agripa.ico" Width="700" Height="760" MinWidth="400" MinHeight="520"
 AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
 Background="Transparent" Foreground="{StaticResource InkBrush}"
 FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/>
 </shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="0">
  <Grid>
   <Grid x:Name="ExpandedPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Height="48" Background="{StaticResource BackgroundBrush}" Margin="0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Title_MouseLeftButtonDown" Background="Transparent" VerticalAlignment="Stretch" Margin="12,0,0,0">
      <Image Source="Assets/agripa.ico" Width="26" Height="26" Margin="0,0,9,0"/>
      <TextBlock Text="Agripa" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="HotkeyHint" Visibility="Collapsed"/>
     </StackPanel>
     <Button Grid.Column="1" x:Name="CompactButton" Style="{StaticResource IconButtonStyle}" Click="Compact_Click" ToolTip="{DynamicResource CompactMode}" AutomationProperties.Name="{DynamicResource CompactMode}" AutomationProperties.AutomationId="CompactButton" Margin="0,0,6,0"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M6,5 L18,5 Q20,5 20,7 L20,17 Q20,19 18,19 L6,19 Q4,19 4,17 L4,7 Q4,5 6,5 M4,10 L20,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
     <Button Grid.Column="2" x:Name="HideButton" Style="{StaticResource IconButtonStyle}" Click="Hide_Click" ToolTip="{DynamicResource HideEsc}" AutomationProperties.Name="{DynamicResource HideOverlay}" AutomationProperties.AutomationId="HideButton" Margin="0,0,12,0"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M5,12 L19,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
    </Grid>
    <Border Grid.Row="1" Height="44" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0,12,8">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="CaptureButton" Background="#293E32" BorderBrush="#536F5E" Foreground="#D6EFDF" ToolTip="{DynamicResource CaptureShortcut}" AutomationProperties.Name="{DynamicResource CaptureName}" Click="Capture_Click" AutomationProperties.AutomationId="CaptureButton">
       <StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M8,6 L10,4 L14,4 L16,6 L20,6 L20,20 L4,20 L4,6 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="{DynamicResource CaptureLabel}" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
      </Button>
      <Button Grid.Column="1" x:Name="CropCaptureButton" Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource CropCapture}" AutomationProperties.Name="{DynamicResource CropName}" Click="CropCapture_Click" Margin="5,0,0,0" AutomationProperties.AutomationId="CropCaptureButton"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M7,3 L7,17 L21,17 M3,7 L17,7 L17,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
      <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Margin="10,7,6,7" Padding="12,0,0,0">
       <TextBox x:Name="BrowserAddressBox" IsReadOnly="True" Text="https://chatgpt.com/" Style="{StaticResource BrowserAddressStyle}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{DynamicResource PageAddress}" AutomationProperties.AutomationId="BrowserAddressBox"/>
      </Border>
      <Button Grid.Column="3" x:Name="SettingsButton" Style="{StaticResource SettingsButtonStyle}" ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}" Click="Settings_Click" Margin="0,0,6,0" AutomationProperties.AutomationId="SettingsButton"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,7 L6,7 M12,7 L20,7 M4,17 L12,17 M18,17 L20,17 M12,7 A3,3 0 1 1 6,7 A3,3 0 1 1 12,7 M18,17 A3,3 0 1 1 12,17 A3,3 0 1 1 18,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
      <Button Grid.Column="4" x:Name="BrowserMoreButton" Style="{StaticResource IconButtonStyle}" ToolTip="{DynamicResource MoreBrowserActions}" AutomationProperties.Name="{DynamicResource MoreBrowserActions}" Click="BrowserMore_Click" AutomationProperties.AutomationId="BrowserMoreButton">
       <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M6,12 A1,1 0 1 1 4,12 A1,1 0 1 1 6,12 M13,12 A1,1 0 1 1 11,12 A1,1 0 1 1 13,12 M20,12 A1,1 0 1 1 18,12 A1,1 0 1 1 20,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
       <Button.ContextMenu>
        <ContextMenu x:Name="BrowserMoreMenu" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource BorderBrush}">
         <MenuItem Header="{DynamicResource Home}" Click="BrowserHome_Click"/>
         <MenuItem x:Name="BrowserReloadMenuItem" Header="{DynamicResource Reload}" Click="BrowserReload_Click"/>
         <MenuItem Header="{DynamicResource OpenExternal}" Click="BrowserExternal_Click"/>
        </ContextMenu>
       </Button.ContextMenu>
      </Button>
     </Grid>
    </Border>
    <Grid Grid.Row="2" x:Name="BrowserPanel">
      <Grid x:Name="BrowserHost"/>
      <Border x:Name="BrowserNotice" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource BackgroundBrush}" Padding="14" Visibility="Visible">
       <StackPanel>
        <TextBlock x:Name="BrowserNoticeText" Text="{DynamicResource PreparingBrowser}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
        <Button x:Name="InstallBrowserButton" Content="{DynamicResource DownloadWebView}" Click="InstallBrowser_Click" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.AutomationId="InstallBrowserButton"/>
       </StackPanel>
      </Border>

    </Grid>
    <Grid Grid.Row="2" x:Name="SettingsPanel" Background="{StaticResource BackgroundBrush}" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24" >
      <StackPanel>
       <TextBlock Text="{DynamicResource Settings}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,5"/>
       <TextBlock Text="{DynamicResource SettingsIntro}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,28"/>

      <TextBlock Text="{DynamicResource Appearance}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <TextBlock Text="{DynamicResource AppearanceHelp}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10"/>
      <DockPanel Margin="0,8,0,5" LastChildFill="True">
       <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Text="85 %" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="8,0,0,0" AutomationProperties.AutomationId="OpacityValueText"/>
       <TextBlock Text="{DynamicResource Opacity}" VerticalAlignment="Center"/>
      </DockPanel>
      <Slider x:Name="OpacitySlider" Margin="0,12,0,7" Minimum="30" Maximum="100" Value="85" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
       ValueChanged="OpacitySlider_ValueChanged" AutomationProperties.Name="{DynamicResource OverlayOpacity}" AutomationProperties.AutomationId="OpacitySlider"/>
      <DockPanel Margin="0,0,0,18"><TextBlock DockPanel.Dock="Right" Text="{DynamicResource MoreSolid}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/><TextBlock Text="{DynamicResource MoreTransparent}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></DockPanel>
      <StackPanel Orientation="Horizontal" Margin="0,7,0,10">
       <TextBlock Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <ComboBox x:Name="LanguageSelector" Width="128" SelectedValuePath="Tag" SelectionChanged="LanguageSelector_SelectionChanged" AutomationProperties.Name="{DynamicResource LanguageLabel}">
        <ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="English" Tag="en"/>
       </ComboBox>
      </StackPanel>
      <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,24"/>
      <TextBlock Text="{DynamicResource Shortcuts}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="{DynamicResource ShortcutsHelp}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{DynamicResource ShowHideAction}" VerticalAlignment="Center" Margin="0,3"/>
       <Button x:Name="ShowHideHotkeyButton" Grid.Column="1" Content="Ctrl+Alt+Space" Tag="Ctrl+Alt+Space" Click="ShortcutButton_Click" Margin="4,2" AutomationProperties.Name="{DynamicResource ShowHideAction}" AutomationProperties.AutomationId="ShowHideHotkeyButton"/>
       <TextBlock Grid.Row="1" Text="{DynamicResource CaptureName}" VerticalAlignment="Center" Margin="0,3"/>
       <Button x:Name="CaptureHotkeyButton" Grid.Row="1" Grid.Column="1" Content="Ctrl+Alt+C" Tag="Ctrl+Alt+C" Click="ShortcutButton_Click" Margin="4,2" AutomationProperties.Name="{DynamicResource CaptureName}" AutomationProperties.AutomationId="CaptureHotkeyButton"/>
       <TextBlock Grid.Row="2" Text="{DynamicResource ClickThroughAction}" VerticalAlignment="Center" Margin="0,3"/>
       <Button x:Name="ClickThroughHotkeyButton" Grid.Row="2" Grid.Column="1" Content="Ctrl+Alt+P" Tag="Ctrl+Alt+P" Click="ShortcutButton_Click" Margin="4,2" AutomationProperties.Name="{DynamicResource ClickThroughAction}" AutomationProperties.AutomationId="ClickThroughHotkeyButton"/>
       <TextBlock Grid.Row="3" Text="{DynamicResource CompactMode}" VerticalAlignment="Center" Margin="0,3"/>
       <Button x:Name="CompactHotkeyButton" Grid.Row="3" Grid.Column="1" Content="Ctrl+Alt+M" Tag="Ctrl+Alt+M" Click="ShortcutButton_Click" Margin="4,2" AutomationProperties.Name="{DynamicResource CompactMode}" AutomationProperties.AutomationId="CompactHotkeyButton"/>
       <TextBlock Grid.Row="4" Text="{DynamicResource OpacityIncreaseAction}" VerticalAlignment="Center" Margin="0,3"/>
       <Button x:Name="OpacityIncreaseHotkeyButton" Grid.Row="4" Grid.Column="1" Content="Ctrl+Alt+O" Tag="Ctrl+Alt+O" Click="ShortcutButton_Click" Margin="4,2" AutomationProperties.AutomationId="OpacityIncreaseHotkeyButton"/>
       <TextBlock Grid.Row="5" Text="{DynamicResource OpacityDecreaseAction}" VerticalAlignment="Center" Margin="0,3"/>
       <Button x:Name="OpacityDecreaseHotkeyButton" Grid.Row="5" Grid.Column="1" Content="Ctrl+Alt+Shift+O" Tag="Ctrl+Alt+Shift+O" Click="ShortcutButton_Click" Margin="4,2" AutomationProperties.AutomationId="OpacityDecreaseHotkeyButton"/>
      </Grid>
      <TextBlock Text="{DynamicResource TrayRecoveryHelp}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,7"/>
      <CheckBox x:Name="ClickThroughToggle" Content="{DynamicResource ClickThroughAction}" Checked="ClickThroughToggle_Changed" Unchecked="ClickThroughToggle_Changed" AutomationProperties.AutomationId="ClickThroughToggle" Margin="0,0,0,2"/>
      <TextBlock Text="{DynamicResource ClickThroughHelp}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,20,0,24"/>
      <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,24"/>
      <TextBlock Text="{DynamicResource GameProfiles}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="{DynamicResource ProfilesHelp}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
      <TextBlock Text="{DynamicResource ProfileName}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,3"/>
      <TextBox x:Name="ProfileNameBox" AutomationProperties.Name="{DynamicResource ProfileName}" Margin="0,0,0,5"/>
      <DockPanel Margin="0,0,0,5">
       <Button DockPanel.Dock="Right" Content="{DynamicResource ApplyProfile}" Click="ApplyProfile_Click" Margin="5,0,0,0" AutomationProperties.AutomationId="ApplyProfileButton"/>
       <ComboBox x:Name="ProfileSelector" SelectionChanged="ProfileSelector_SelectionChanged" AutomationProperties.Name="{DynamicResource GameProfiles}"/>
      </DockPanel>
      <WrapPanel Margin="0,0,0,8">
       <Button Content="{DynamicResource SaveProfile}" Click="SaveProfile_Click" Margin="0,0,5,4" AutomationProperties.AutomationId="SaveProfileButton"/>
       <Button Content="{DynamicResource DeleteProfile}" Click="DeleteProfile_Click" Margin="0,0,0,4" AutomationProperties.AutomationId="DeleteProfileButton"/>
      </WrapPanel>

      <Button Content="{DynamicResource ExitApp}" Style="{StaticResource ExitButtonStyle}" Click="Exit_Click" HorizontalAlignment="Left" Margin="0,1,0,6" AutomationProperties.AutomationId="ExitButton"/>

      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
       <Button Content="{DynamicResource CancelChanges}" Click="Back_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="BackButton"/>
       <Button Content="{DynamicResource SaveChanges}" Click="SaveSettings_Click" Background="{StaticResource AccentBrush}" Foreground="{StaticResource BackgroundBrush}" AutomationProperties.AutomationId="SaveSettingsButton"/>
      </StackPanel>
     </Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource BackgroundBrush}" Height="30" Padding="12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
     <Grid VerticalAlignment="Center" Margin="12,0,0,0">
      <Ellipse Width="5" Height="5" Fill="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
      <TextBlock x:Name="StatusText" Visibility="Collapsed" Text="{DynamicResource ReadyEsc}" Foreground="{StaticResource MutedBrush}" FontSize="11"
       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="BrowserStatusText" Text="{DynamicResource ChatEsc}" Foreground="{StaticResource MutedBrush}" FontSize="11"
       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="BrowserStatusText" AutomationProperties.LiveSetting="Polite"/>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="CompactPanel" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}" Margin="12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="Assets/agripa.ico" Width="22" Height="22" Margin="2,0,7,0" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" MouseLeftButtonDown="CompactPanel_MouseLeftButtonDown" Background="Transparent">
     <TextBlock Text="Agripa" FontWeight="SemiBold" FontSize="13"/>
     <TextBlock x:Name="CompactStatusText" Text="{DynamicResource CompactReady}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <Button Grid.Column="2" x:Name="RestorePanelButton" Click="Compact_Click" ToolTip="{DynamicResource RestorePanel}" AutomationProperties.Name="{DynamicResource RestorePanel}" AutomationProperties.AutomationId="RestorePanelButton" Style="{StaticResource IconButtonStyle}"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M6,5 L18,5 Q20,5 20,7 L20,17 Q20,19 18,19 L6,19 Q4,19 4,17 L4,7 Q4,5 6,5 M4,10 L20,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
   </Grid>
  </Grid>
 </Border>
</Window>
